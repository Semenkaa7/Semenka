using namespace std;
int max2(int a, int b) {
	if (a > b) {
		return a;
	}
	else {
		return b;
	}
}
void playGame() {
	int player = 0;
	int computer = 0;
	cout << "Начинаемм!!!";
	for (int round = 1; round <= 5; round++) {
		cout << "\n Раунд [" << round << "/5] | счет: " << player << " : " << computer << "\n";

		int playernum;

		while (true) {
			cout << "Ваше число ";
			cin >> playernum;
			if (playernum >= 1 && playernum <= 10) {
				break;
			}
			cout << "Ошибка! Введите число 1-10\n";
		}

		int compnum = rand() % 10 + 1;
		cout << "Число компьютера: " << compnum << "\n";
		int win = max2(playernum, compnum);
		if (playernum == compnum) {
			cout << "Ничья\n";
			cout << "Ничья! Очки не начисляются\n";
		}
		else if (win == playernum) {
			cout << "Игрок победил\n";
			cout << "Побеждает число " << compnum << "Вы получаете очко\n";
			player++;
		}
	}

	cout << "\n Игра закончена!  \n";
	cout << "Итоговый счёт: Игрок" << "Игрок победил!" << " : " << player << " : " << computer << "Компьютер\n";

	if (player > computer) {
		cout << "Поздравляем, вы выиграли!\n";
	}
	else if (computer > player) {
		cout << "Компьютер победил\n";
	}
	else {
		cout << "общая ничья\n";
	}
	cout << "\nНажмите Enter для возврата в меню...";
	cin.ignore();
	cin.get();
}
